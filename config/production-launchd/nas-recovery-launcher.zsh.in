#!/bin/zsh
set -eu
unsetopt BG_NICE

PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH

readonly APP_DIR="__PRODUCTION_ROOT__"
readonly -a EXPECTED_HEADS=(
__EXPECTED_HEADS__
)
readonly SERVICE_PYTHON="__SERVICE_PYTHON__"
readonly STATE_DIR="__STATE_DIR__"
readonly LOG_DIR="__LOG_DIR__"
readonly LAUNCHER_LOG="$LOG_DIR/launcher.log"

/bin/mkdir -p "$STATE_DIR" "$LOG_DIR"

log_line() {
  /usr/bin/printf '%s | service=nas-recovery | %s\n' \
    "$(/bin/date '+%Y-%m-%dT%H:%M:%S%z')" "$1" >> "$LAUNCHER_LOG"
}

fail_closed() {
  log_line "preflight_failed code=$1"
  exit "${2:-78}"
}

log_line "preflight_started"
[[ -d "$APP_DIR" ]] || fail_closed "production_root_not_ready" 75
[[ -x "$SERVICE_PYTHON" ]] || fail_closed "production_python_unavailable"
[[ -f "$APP_DIR/nas_recovery_supervisor.py" && ! -L "$APP_DIR/nas_recovery_supervisor.py" ]] \
  || fail_closed "supervisor_entrypoint_invalid"

observed_head=$(/usr/bin/git -C "$APP_DIR" rev-parse HEAD 2>> "$LAUNCHER_LOG") \
  || fail_closed "git_head_unreadable"
head_allowed=false
for expected_head in "${EXPECTED_HEADS[@]}"; do
  if [[ "$observed_head" == "$expected_head" ]]; then
    head_allowed=true
    break
  fi
done
[[ "$head_allowed" == true ]] || fail_closed "production_head_mismatch"
/usr/bin/git -C "$APP_DIR" diff --quiet HEAD -- 2>> "$LAUNCHER_LOG" \
  || fail_closed "production_tracked_changes"
/usr/bin/git -C "$APP_DIR" diff --cached --quiet 2>> "$LAUNCHER_LOG" \
  || fail_closed "production_index_changes"

cd "$APP_DIR" || fail_closed "production_chdir_failed" 75
unset PYTHONPATH PYTHONHOME VIRTUAL_ENV
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1

log_line "exec_approved head=$observed_head"
exec "$SERVICE_PYTHON" "$APP_DIR/nas_recovery_supervisor.py" \
  --allow-service-restart \
  --state-dir "$STATE_DIR"

# Content Extraction V2 non-secret configuration reference.
# Lifecycle: EXPERIMENTAL / PRODUCTION_REJECTED. Keep the production pipeline on v1.
AAIE_CRM_CONTENT_EXTRACTION_PIPELINE=v1
AAIE_CRM_CONTENT_EXTRACTION_SERVICE_URL=http://127.0.0.1:8792
AAIE_CRM_CONTENT_EXTRACTION_SERVICE_DB=database/content_extraction_service.db
AAIE_CRM_CONTENT_EXTRACTION_DATA_ROOT=data/content_extraction
AAIE_CRM_CONTENT_EXTRACTION_CACHE_ROOT=cache/content_extractions/v2
AAIE_CRM_CONTENT_EXTRACTION_RUNTIME_PYTHON=cache/content_extractions/runtime/venv/bin/python
PADDLE_PDX_CACHE_HOME=cache/content_extractions/runtime/paddlex
PADDLE_PDX_MODEL_SOURCE=BOS
AAIE_CRM_CONTENT_EXTRACTION_FFMPEG_PATH=vendor/content_extraction/imageio_ffmpeg/binaries/ffmpeg-macos-aarch64-v7.1
AAIE_CRM_CONTENT_EXTRACTION_SAMPLING_PROFILE=initial-2fps
AAIE_CRM_CONTENT_EXTRACTION_FRAME_FPS=2
AAIE_CRM_CONTENT_EXTRACTION_MAX_FRAMES=1800
AAIE_CRM_CONTENT_EXTRACTION_FFMPEG_TIMEOUT_SECONDS=900
AAIE_CRM_CONTENT_EXTRACTION_PREPROCESSING_VERSION=opencv-subtitle-v1
BILLING_MODE=FREE_ONLY
OCR_CLOUD_ARBITRATION_ORDER=tencent,iflytek

# EasyOCR is isolated from the CRM/Paddle Python environments. Models are
# downloaded once during explicit setup; normal inference is offline-only.
AAIE_CRM_CONTENT_EXTRACTION_EASYOCR_ENABLED=false
AAIE_CRM_CONTENT_EXTRACTION_EASYOCR_PYTHON=cache/content_extractions/runtime/easyocr-venv/bin/python
AAIE_CRM_CONTENT_EXTRACTION_EASYOCR_MODEL_DIR=cache/content_extractions/runtime/easyocr-models
AAIE_CRM_CONTENT_EXTRACTION_EASYOCR_TIMEOUT_SECONDS=120

# Tencent GeneralAccurateOCR. Real values belong only in the project root
# .env.production (or process environment), never in this example file.
TENCENT_OCR_SECRET_ID=
TENCENT_OCR_SECRET_KEY=
TENCENT_OCR_FREE_ONLY_ALLOWED=

# iFlytek Universal Character Recognition. Real values belong only in the
# project root .env.production (or process environment).
IFLYTEK_OCR_APP_ID=
IFLYTEK_OCR_API_KEY=
IFLYTEK_OCR_API_SECRET=
IFLYTEK_OCR_FREE_ONLY_ALLOWED=

# Provider credential names only. Leave values outside source control.
ALIYUN_ASR_ACCESS_KEY_ID=
ALIYUN_ASR_ACCESS_KEY_SECRET=
ALIYUN_ASR_APP_KEY=
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TENCENT_ASR_REGION=
TENCENT_OCR_REGION=
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=

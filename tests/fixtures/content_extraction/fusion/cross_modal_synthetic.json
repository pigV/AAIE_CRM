      "asr": {"start_ms": 2000, "end_ms": 3000, "text": "GPA很重要", "provider_texts": {"funasr": "GPS很重要", "whispercpp": "GPA很重要"}, "status": "ASR_CRITICAL_TOKEN_CONFLICT"},
      "expected": {"status": "CROSS_MODAL_CRITICAL_TOKEN_RESOLVED", "text": "GPA很重要", "final_truth": false}
    },
    {
      "id": "gps_ocr_unresolved",
      "ocr": {"start_ms": 2000, "end_ms": 3000, "text": "GPS很重要", "role": "spoken_subtitle", "providers": ["paddle", "easyocr"]},
      "asr": {"start_ms": 2000, "end_ms": 3000, "text": "GPA很重要", "provider_texts": {"funasr": "GPS很重要", "whispercpp": "GPA很重要"}, "status": "ASR_CRITICAL_TOKEN_CONFLICT"},
      "expected": {"status": "CROSS_MODAL_CRITICAL_CONFLICT", "text": "GPA很重要", "final_truth": false}
    },
    {
      "id": "education_chinese_corroboration",
      "ocr": {"start_ms": 3000, "end_ms": 4000, "text": "学校教育安排", "role": "spoken_subtitle", "providers": ["paddle", "easyocr"]},
      "asr": {"start_ms": 3000, "end_ms": 4000, "text": "学校教务安排", "provider_texts": {"funasr": "学校教务安排", "whispercpp": "学校教育安排"}},
      "expected": {"status": "CROSS_MODAL_RESOLVED", "text": "学校教育安排", "final_truth": false}
    },
    {
      "id": "graduation_subtitle_resolution",
      "ocr": {"start_ms": 4000, "end_ms": 5000, "text": "可以毕业", "role": "spoken_subtitle", "providers": ["paddle", "easyocr"]},
      "asr": {"start_ms": 4000, "end_ms": 5000, "text": "配不了业", "provider_texts": {"funasr": "配不了业", "whispercpp": "可以养业"}},
      "expected": {"status": "CROSS_MODAL_RESOLVED", "text": "可以毕业", "final_truth": false}

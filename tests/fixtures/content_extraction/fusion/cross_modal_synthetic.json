    {
      "id": "source_mismatch",
      "ocr": {"source_video_id": "video-A", "start_ms": 0, "end_ms": 1000, "text": "EAL"},
      "asr": {"source_video_id": "video-B", "start_ms": 0, "end_ms": 1000, "text": "ESL"},

      "id": "exact_consensus",
      "ocr": {"start_ms": 0, "end_ms": 1000, "text": "孩子申请500签证", "role": "spoken_subtitle", "providers": ["paddle", "easyocr"]},
      "asr": {"start_ms": 0, "end_ms": 1000, "text": "孩子申请500签证", "providers": ["funasr", "whispercpp"]},
      "expected": {"status": "CROSS_MODAL_CONSENSUS", "final_truth": false}
    },
    {
      "id": "eal_esl_strong_ocr",
      "ocr": {"start_ms": 1000, "end_ms": 2000, "text": "EAL课要是高二还没过的话", "role": "spoken_subtitle", "providers": ["paddle", "easyocr"]},
      "asr": {"start_ms": 1000, "end_ms": 2000, "text": "ESL课要是高二还没过的话", "provider_texts": {"funasr": "ESL课要是高二还没过的话", "whispercpp": "ESL课要是高二还没过的话"}},
      "expected": {"status": "CROSS_MODAL_CRITICAL_TOKEN_RESOLVED", "text": "EAL课要是高二还没过的话", "final_truth": false}
    },
    {
      "id": "eal_esl_weak_ocr",
      "ocr": {"start_ms": 1000, "end_ms": 2000, "text": "EAL课", "role": "spoken_subtitle", "providers": ["paddle"]},
      "asr": {"start_ms": 1000, "end_ms": 2000, "text": "ESL课"},
      "expected": {"status": "CROSS_MODAL_CRITICAL_CONFLICT", "text": "ESL课", "final_truth": false}
    },
    {
      "id": "gpa_ocr_resolves",
